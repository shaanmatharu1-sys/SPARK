# ── Polygon.io ──────────────────────────────────────────────────
POLYGON_API_KEY=your_polygon_api_key_here

# ── FRED (St. Louis Fed) ────────────────────────────────────────
FRED_API_KEY=your_fred_api_key_here

# ── NewsAPI ─────────────────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key_here        # https://newsapi.org (free tier: 100req/day)

# ── Finnhub (analyst ratings / price targets) ───────────────────
FINNHUB_API_KEY=your_finnhub_api_key_here # https://finnhub.io (free tier)

# ── EODHD (live equity trades + top-of-book quotes) ─────────────
# https://eodhd.com — real-time WS for US stocks (trades + bid/ask), the
# live-tick + equity-quote data source for this app. Not free, but the
# only vendor here whose real-time entitlement was actually confirmed
# working (Polygon has no quote entitlement on this plan; see
# services/eodhd_ws_client.py for the verification notes).
EODHD_API_KEY=your_eodhd_api_key_here

# ── Webull OpenAPI (crypto snapshots — free tier, no market-data ──
# subscription required for crypto). Get App Key/Secret at
# developer.webull.com after registering an OpenAPI app.
WEBULL_APP_KEY=your_webull_app_key_here
WEBULL_APP_SECRET=your_webull_app_secret_here
WEBULL_REGION=us

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Database (durable per-user data: accounts, watchlists, portfolios) ──
# Local dev default (backend/config.py) falls back to a SQLite file if unset.
DATABASE_URL=postgresql+asyncpg://terminal:terminal@localhost:5432/terminal

# ── Auth ────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string   # required in production — tokens are insecure/ephemeral without it
SIGNUP_INVITE_CODE=                            # optional — if set, /auth/signup requires this code

# ── App ─────────────────────────────────────────────────────────
ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Watchlist (comma-separated) ─────────────────────────────────
DEFAULT_WATCHLIST=SPY,QQQ,IWM,AAPL,MSFT,NVDA,TSLA,META,GOOGL,AMZN

# ── Sector ETFs ─────────────────────────────────────────────────
SECTOR_ETFS=XLF,XLE,XLK,XLV,XLI,XLB,XLU,XLRE,XLC,XLP,XLY
